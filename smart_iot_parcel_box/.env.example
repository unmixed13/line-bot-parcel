# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
ENVIRONMENT=development
DEBUG=true
APP_NAME=Smart IoT Parcel Box

# --- Security ---
# Shared secret ESP32 devices send as header "X-API-Key" on every /api/* call.
# Generate a real random value — never use the example below in production.
HARDWARE_API_KEY=my_super_secret_key_123

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Shared secret for the operator dashboard's WebSocket (?token=... query
# param on /ws/dashboard). Leave blank only for local dev — the dashboard
# feed is unauthenticated (open to anyone who finds the URL) if unset.
DASHBOARD_TOKEN=

# Requests allowed per client IP per minute against /api/*.
RATE_LIMIT_PER_MINUTE=120

# --- Database ---
# Zero-setup local default (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./parcel_box.db
# Production (MySQL) example:
# DATABASE_URL=mysql+aiomysql://parcelbox:parcelbox@localhost:3306/parcel_box?charset=utf8mb4

# --- MQTT ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=parcel-box-server

# --- LINE Messaging API ---
# LINE Notify was shut down on 2025-03-31 — this project uses a LINE
# Official Account's Messaging API "push message" endpoint instead.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
LINE_MESSAGING_API_URL=https://api.line.me/v2/bot/message/push

# Public HTTPS base URL for this server (ngrok/Cloudflare Tunnel in dev, your
# real domain in production). Only needed for LINE image messages.
PUBLIC_BASE_URL=

# --- File storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=8
