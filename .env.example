# Copy this file to .env and fill in real values. Never commit .env.

# LINE Messaging API channel access token (required — bot cannot reply/push without it)
LINE_CHANNEL_ACCESS_TOKEN=

# LINE channel secret — used to verify that /webhook requests really come from LINE.
# Strongly recommended; without it, anyone who finds the webhook URL can forge events.
LINE_CHANNEL_SECRET=

# Shared secret the ESP32 must send (header "X-API-Key" or query "?key=") to call
# /command and /sensor. Leave blank only for local testing — those endpoints are
# open to anyone who finds the URL if this is unset.
DEVICE_API_KEY=

# Optional — only used if adafruit.js is wired back into index.js
ADAFRUIT_IO_USERNAME=
ADAFRUIT_IO_KEY=

PORT=10000
NODE_ENV=production

# Optional rate-limit tuning (defaults shown)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_HARDWARE_MAX=300
# RATE_LIMIT_WEBHOOK_MAX=120
